# Copy to .env (git-ignored), fill it in, then generate lib/core/config/env.g.dart:
#   fvm dart run build_runner build --delete-conflicting-outputs
# Re-run that command whenever this file changes.

# TMDB → Settings → API → "API Read Access Token" (the long v4 bearer token).
# Obfuscated in the build by envied.
TMDB_TOKEN=
TMDB_LANGUAGE=en-US
# Optional: country for movie release dates (e.g. ID)
TMDB_REGION=
# dev | staging | prod (Chucker only in dev)
APP_ENV=dev
