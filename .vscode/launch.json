{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CineCatalog (dev)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    },
    {
      "name": "CineCatalog (staging, no Chucker)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": ["--dart-define=APP_ENV=staging"]
    },
    {
      "name": "CineCatalog (profile)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "program": "lib/main.dart"
    },
    {
      "name": "CineCatalog (release)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "program": "lib/main.dart",
      "toolArgs": ["--dart-define=APP_ENV=prod"]
    }
  ]
}
